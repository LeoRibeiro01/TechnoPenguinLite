# Configurações do projeto. Copie este arquivo para ".env" (o .env não vai para o Git).

APP_NAME=TechnoPenguin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

# Banco de dados MySQL do XAMPP (usuário root, sem senha)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=technopenguin
DB_USERNAME=root
DB_PASSWORD=

# Sessão e cache em arquivos (pasta storage/), sem precisar de tabelas extras
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=single
LOG_LEVEL=debug

# "log" = os e-mails não são enviados de verdade: ficam escritos em storage/logs/laravel.log.
# Para enviar de verdade, troque para smtp e preencha MAIL_HOST, MAIL_PORT, MAIL_USERNAME e MAIL_PASSWORD.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@technopenguin.com"
MAIL_FROM_NAME="TechnoPenguin"
